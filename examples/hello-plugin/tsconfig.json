{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@neosh/api": ["../../plugins/api/src/index.ts"]
    }
  },
  "include": ["*.ts", "../../plugins/api/src/globals.d.ts"]
}
