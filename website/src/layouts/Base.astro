---
interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = "A terminal workspace where every feature is a plugin. Free, open source, held by its community.",
} = Astro.props;

const fullTitle = title ? `${title} · Neoswarm` : "Neoswarm · An Agent Swarm for Power Users";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${Astro.site}#org`,
      name: "neoswarm",
      url: String(Astro.site),
      logo: new URL("/icon-512.png", Astro.site),
      sameAs: ["https://github.com/neoswarm", "https://discord.gg/cWdMAqcAn5"],
    },
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#site`,
      name: "Neoswarm",
      url: String(Astro.site),
      publisher: { "@id": `${Astro.site}#org` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${Astro.site}#app`,
      name: "Neoswarm",
      alternateName: "neosh",
      description,
      url: String(Astro.site),
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      license: "https://github.com/neoswarm/neosh/blob/main/LICENSE",
      author: { "@id": `${Astro.site}#org` },
      sameAs: ["https://github.com/neoswarm/neosh"],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Neoswarm" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="neoswarm: an agent swarm for power users" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@meszmatew" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link
      rel="preload"
      as="image"
      type="image/webp"
      imagesrcset="/hero-bg-800.webp 800w, /hero-bg-1600.webp 1600w"
      imagesizes="(max-width: 900px) 100vw, 1520px"
      fetchpriority="high"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grid-bg" aria-hidden="true"></div>
    <slot />
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
