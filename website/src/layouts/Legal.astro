---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />
  <main>
    <article class="legal">
      <header>
        <p class="eyebrow">Legal</p>
        <h1>{title}</h1>
        <p class="updated">Last updated {updated}</p>
      </header>
      <div class="body">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>

<style>
  .legal {
    max-width: 760px;
    margin: 0 auto;
    padding: 200px 40px 120px;
  }

  h1 {
    font-size: clamp(34px, 4.5vw, 52px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin: 0 0 14px;
  }

  .updated {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--dim);
    margin: 0;
  }

  .body {
    margin-top: 64px;
  }

  .body :global(h2) {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 56px 0 14px;
  }

  .body :global(h2:first-child) {
    margin-top: 0;
  }

  .body :global(p),
  .body :global(li) {
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.75;
  }

  .body :global(p) {
    margin: 0 0 16px;
  }

  .body :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .body :global(li) {
    margin-bottom: 8px;
  }

  .body :global(li::marker) {
    color: var(--dim);
  }

  .body :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-strong);
    transition: text-decoration-color 0.2s ease;
  }

  .body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .body :global(strong) {
    color: var(--fg);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .legal {
      padding: 160px 24px 80px;
    }
  }
</style>
