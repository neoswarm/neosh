---
import Logo from "./Logo.astro";
---

<header>
  <nav class="wrap">
    <Logo />
    <div class="links">
      <a href="/plugins">Plugins</a>
      <a class="gh" target="_blank" rel="noopener" href="https://github.com/neoswarm/neosh" title="Star neoswarm/neosh on GitHub">
        <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        Star
        <span class="count" id="gh-stars" hidden></span>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 116px;
  }

  nav :global(.logo img) {
    height: 40px;
    width: auto;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 40px;
    font-size: 17px;
    font-weight: 500;
    color: var(--muted);
  }

  .links a {
    transition: color 0.2s ease;
  }

  .links a:hover {
    color: var(--fg);
  }

  /* just a link, like the others — the count is the whole pitch */
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .count {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .links a:not(.gh) {
      display: none;
    }
  }
</style>

<script>
  const count = document.getElementById("gh-stars")!;

  const fmt = (n: number) =>
    n >= 10_000 ? `${Math.round(n / 1000)}k` : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : `${n}`;

  const show = (n: number) => {
    count.textContent = `★ ${fmt(n)}`;
    count.hidden = false;
  };

  const cached = sessionStorage.getItem("gh-stars");
  if (cached) {
    show(Number(cached));
  } else {
    fetch("https://api.github.com/repos/neoswarm/neosh")
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((repo) => {
        if (typeof repo.stargazers_count !== "number") return;
        sessionStorage.setItem("gh-stars", String(repo.stargazers_count));
        show(repo.stargazers_count);
      })
      .catch(() => {}); // no count is fine; the button still reads "Star"
  }
</script>
