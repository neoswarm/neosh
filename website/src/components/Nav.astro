---
import Logo from "./Logo.astro";
---

<header>
  <nav class="wrap">
    <Logo />
    <div class="links">
      <a href="/docs">Documentation</a>
      <a href="/plugins">Plugins</a>
      <a class="discord" target="_blank" rel="noopener" href="https://discord.gg/cWdMAqcAn5" aria-label="Join the neosh Discord" title="Join the neosh Discord">
        <svg width="20" height="20" viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
          <path
            d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"
          />
        </svg>
      </a>
      <a class="gh" target="_blank" rel="noopener" href="https://github.com/neoswarm/neosh" title="Star neoswarm/neosh on GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        <svg class="star" width="17" height="17" viewBox="0 0 24 24" fill="#f97316" aria-hidden="true">
          <path
            d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"
          />
        </svg>
        <span class="count" id="gh-stars"></span>
      </a>
    </div>
  </nav>
</header>

<style>
  header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100px;
  }

  nav :global(.logo img) {
    height: 36px;
    width: auto;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 38px;
    font-size: 16px;
    font-weight: 500;
    color: var(--muted);
  }

  .links a {
    transition: color 0.2s ease;
  }

  /* :not(.gh), or this near-white wins over the pill's own hover and turns
     the octocat invisible on the light background */
  .links a:not(.gh):hover {
    color: var(--fg);
  }

  /* The one place the logo does the whole job: no word, no pill — an icon in the
     row, warming to the brand's blurple on hover. */
  .discord {
    display: inline-flex;
    align-items: center;
  }

  .discord:hover {
    color: #5865f2 !important;
  }

  /* the one button on the page: a small warm-white pill, octocat and an
     amber star doing the talking — no words, and no theatrics: hover only
     warms the colour */
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 34px;
    padding: 0 14px;
    border-radius: 999px;
    background: #e3e1dc;
    color: #0b0b0d;
    transition: background 0.25s ease;
  }

  .gh:hover {
    background: #f0eeea;
  }

  .gh svg {
    width: 16px;
    height: 16px;
  }

  .gh .star {
    width: 15px;
    height: 15px;
    margin-left: 3px;
    /* a touch of its own light, so it reads at a glance on the pale pill */
    filter: drop-shadow(0 0 3px rgba(249, 115, 22, 0.4));
  }

  /* the count arrives, it does not pop: the pill widens and the number
     slides in once the API has answered */
  .count {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: #3d3a33;
    max-width: 0;
    margin-left: -7px;
    opacity: 0;
    overflow: hidden;
    transform: translateX(-4px);
    transition:
      max-width 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      margin-left 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.4s ease 0.12s,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .count.in {
    max-width: 64px;
    margin-left: 0;
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gh,
    .gh .star,
    .count {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .links a:not(.gh) {
      display: none;
    }
  }
</style>

<script>
  const count = document.getElementById("gh-stars")!;

  const fmt = (n: number) =>
    n >= 10_000 ? `${Math.round(n / 1000)}k` : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : `${n}`;

  const show = (n: number) => {
    count.textContent = fmt(n);
    // next frame, so the width/opacity transition has a "from" to leave
    requestAnimationFrame(() => count.classList.add("in"));
  };

  const cached = sessionStorage.getItem("gh-stars");
  if (cached) {
    show(Number(cached));
  } else {
    fetch("https://api.github.com/repos/neoswarm/neosh")
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((repo) => {
        if (typeof repo.stargazers_count !== "number") return;
        sessionStorage.setItem("gh-stars", String(repo.stargazers_count));
        show(repo.stargazers_count);
      })
      .catch(() => {}); // no count is fine; the button still reads "Star"
  }
</script>
