---
interface Plugin {
  name: string;
  description: string;
  author: string;
  repo: string;
  tags: string[];
}

const modules = import.meta.glob<{ default: Plugin }>("../data/plugins/*.json", { eager: true });
const plugins = Object.entries(modules)
  .filter(([path]) => !path.includes("_template"))
  .map(([, m]) => m.default)
  .sort((a, b) => a.name.localeCompare(b.name));

const GUIDE = "https://github.com/neoswarm/neosh/blob/main/website/src/data/plugins/README.md";
---

<section id="plugins">
  <div class="wrap">
    <p class="eyebrow">Plugins</p>
    <h2>Made by people like you.</h2>
    <p class="lede">
      Every plugin here arrived as a pull request. Yours can too.
    </p>
    <div class="grid">
      {
        plugins.map((p, i) => (
          <a class="card plug" href={p.repo} data-reveal style={`transition-delay:${(i % 3) * 60}ms`}>
            <div class="head">
              <span class="name">{p.name}</span>
              <span class="author">{p.author}</span>
            </div>
            <p>{p.description}</p>
          </a>
        ))
      }
      <a class="card plug add" href={GUIDE} data-reveal>
        <span class="plus">+</span>
        <span>Add yours</span>
        <p>One file, one pull request</p>
      </a>
    </div>
  </div>
</section>

<style>
  .lede {
    margin-bottom: 72px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .plug {
    padding: 32px 34px;
    transition:
      opacity 0.7s ease,
      transform 0.7s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .plug:hover {
    border-color: var(--line-strong);
    background: #131318;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 8px;
  }

  .name {
    font-family: var(--mono);
    font-size: 16.5px;
    font-weight: 500;
  }

  .author {
    font-size: 13px;
    color: var(--dim);
  }

  .plug p {
    color: var(--muted);
    font-size: 15px;
    margin: 0;
  }

  .add {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-style: dashed;
    text-align: center;
    color: var(--muted);
    font-size: 16px;
  }

  .add:hover {
    color: var(--fg);
  }

  .add .plus {
    font-size: 28px;
    line-height: 1;
    color: var(--accent);
  }

  .add p {
    font-size: 13px;
    color: var(--dim);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
