---
const features = [
  {
    title: "Plugins in TypeScript",
    body: "Drop a .ts file in. It runs.",
    icon: `<path d="M12 3v18M3 12h18" stroke-linecap="round"/>`,
  },
  {
    title: "Every key is a binding",
    body: "F1 lists them. Your init.ts moves them.",
    icon: `<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 15h10" stroke-linecap="round"/>`,
  },
  {
    title: "Worktrees built in",
    body: "One key, a fresh tree inside the project.",
    icon: `<path d="M6 3v12M6 15a4 4 0 0 0 4 4h4" stroke-linecap="round"/><circle cx="6" cy="18" r="0.5"/><circle cx="18" cy="19" r="2.5"/><circle cx="6" cy="5" r="2.5"/>`,
  },
  {
    title: "Questions, answered by you",
    body: "The agent asks over the composer. Typing is answering.",
    icon: `<path d="M9 9a3 3 0 1 1 4.2 2.75c-.9.4-1.2 1-1.2 2" stroke-linecap="round"/><circle cx="12" cy="17.5" r="0.6"/><rect x="2.5" y="2.5" width="19" height="19" rx="5"/>`,
  },
  {
    title: "Pair your machines",
    body: "Steer an agent on another computer. Keys you approved, not a network you trust.",
    icon: `<rect x="2.5" y="5" width="8" height="6" rx="1.5"/><rect x="13.5" y="13" width="8" height="6" rx="1.5"/><path d="M10.5 8h6v5M13.5 16h-6v-5" stroke-linecap="round"/>`,
  },
  {
    title: "Careful where it counts",
    body: "Everything irreversible asks. Nothing reversible does.",
    icon: `<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];
---

<section id="features">
  <div class="wrap">
    <p class="eyebrow">Features</p>
    <h2>Ours are the defaults.<br />A default is something you turn off.</h2>
    <div class="grid">
      {
        features.map((f, i) => (
          <div class="card feat" data-reveal style={`transition-delay:${(i % 3) * 80}ms`}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={f.icon} />
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 80px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .feat {
    padding: 40px 38px;
    transition:
      opacity 0.7s ease,
      transform 0.7s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .feat:hover {
    border-color: var(--line-strong);
    background: #131318;
  }

  .feat svg {
    color: var(--accent);
    margin-bottom: 22px;
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
    margin: 0 0 8px;
  }

  p {
    color: var(--muted);
    font-size: 16px;
    margin: 0;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
