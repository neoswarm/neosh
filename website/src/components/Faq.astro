---
const faqs = [
  {
    q: "Can I change how it looks and works?",
    a: "Yes, all of it. The sidebar, the panels, the keys, the colors. Every part of the interface is built on a public API, so a plugin can replace anything we ship with something of your own.",
  },
  {
    q: "Do I need to know Neovim to use it?",
    a: "No. The defaults work out of the box. If you do know Neovim, the keys will feel familiar, and everything can be rebound the same way.",
  },
  {
    q: "Can I write my own plugins?",
    a: "Yes. Plugins are written in TypeScript, and the API is fully typed. The features that ship with neosh are plugins themselves, so anything they can do, yours can too.",
  },
  {
    q: "Can I turn off features I don't use?",
    a: "Yes. Every built-in feature is a plugin, and any plugin can be disabled or replaced in your config.",
  },
  {
    q: "What happens if I close the terminal?",
    a: "Your agents keep running. The workspace runs as its own process, and the terminal is just a window into it. Open it again later and everything is where you left it.",
  },
  {
    q: "Is it free?",
    a: "Yes. neosh is open source under the MIT license. You connect the AI accounts you already have.",
  },
];
---

<section id="faq">
  <div class="wrap two">
    <div class="rail" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 class="headline">Before you install it,<br /><span class="hl">what people want to know.</span></h2>
      <p class="lede">Most of them have the same answer.</p>
      <a class="ask" href="https://github.com/neoswarm/neosh/issues" target="_blank" rel="noopener">
        <span>Open an issue</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>

    <div class="list">
      {
        faqs.map((f, i) => (
          <div class="item" data-reveal style={`transition-delay:${i * 60}ms`}>
            <button class="toggle" aria-expanded="false">
              <span class="q">{f.q}</span>
              <svg class="mark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </button>
            <div class="panel">
              <div class="inner">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 120px 0 130px;
  }

  .two {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 24px 72px;
    align-items: start;
  }

  .rail {
    position: sticky;
    top: 120px;
  }

  .eyebrow {
    font-size: 15px;
    letter-spacing: 0.16em;
    margin-bottom: 22px;
  }

  .headline {
    font-family: "Geist", var(--sans);
    /* "what people want to know." is ~12.75em of Geist 600, so this is the
       size at which it exactly fills the rail — any larger and it breaks
       into a third line with "know." alone on it */
    font-size: clamp(27px, calc(3.2vw - 5px), 48px);
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.25;
    margin: 0 0 18px;
    background: linear-gradient(180deg, #a4a4b0 20%, #6e6e7a);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .headline .hl {
    background: linear-gradient(180deg, #ffffff 30%, #c2c2d0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lede {
    font-size: 18.5px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 360px;
    margin: 0 0 24px;
  }

  .ask {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 500 17.5px var(--sans);
    color: var(--dim);
    transition: color 0.25s ease;
  }

  .ask:hover {
    color: var(--accent);
  }

  .ask svg {
    flex: none;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ask:hover svg {
    transform: translateX(4px);
  }

  .list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .item {
    border-bottom: 1px solid var(--line);
  }

  .toggle {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 28px;
    width: 100%;
    padding: 17px 4px;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .q {
    font-size: 20.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
    color: var(--muted);
    transition: color 0.25s ease;
  }

  .toggle:hover .q,
  .item.open .q {
    color: var(--fg);
  }

  .mark {
    flex: none;
    align-self: center;
    color: var(--dim);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), color 0.25s ease;
  }

  .toggle:hover .mark {
    color: var(--accent);
  }

  .item.open .mark {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .item.open .panel {
    grid-template-rows: 1fr;
  }

  .inner {
    overflow: hidden;
  }

  .inner p {
    margin: 0;
    padding: 0 4px 22px;
    max-width: 680px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.68;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
  }

  .item.open .inner p {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 980px) {
    section {
      padding: 90px 0 100px;
    }

    .two {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .rail {
      position: static;
    }

    .headline {
      /* single column now: the same fit, against the page width */
      font-size: clamp(25px, calc((100vw - 84px) / 13), 48px);
    }

    .lede {
      max-width: none;
      margin-bottom: 24px;
    }

    .toggle {
      padding: 16px 2px;
      gap: 16px;
    }

    .q {
      font-size: 18px;
    }

    .inner p {
      font-size: 16.5px;
      padding: 0 2px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .inner p,
    .mark,
    .ask svg {
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>("#faq .item");

  items.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>(".toggle")!;
    toggle.addEventListener("click", () => {
      const opening = !item.classList.contains("open");
      items.forEach((other) => {
        other.classList.remove("open");
        other.querySelector(".toggle")!.setAttribute("aria-expanded", "false");
      });
      if (opening) {
        item.classList.add("open");
        toggle.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
