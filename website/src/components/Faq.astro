---
const faqs = [
  {
    q: "Can I change how it looks and works?",
    a: "Yes, all of it. The sidebar, the panels, the keys, the colors. Every part of the interface is built on a public API, so a plugin can replace anything we ship with something of your own.",
    tag: "Customization",
  },
  {
    q: "Do I need to know Neovim to use it?",
    a: "No. The defaults work out of the box. If you do know Neovim, the keys will feel familiar, and everything can be rebound the same way.",
    tag: "Basics",
  },
  {
    q: "Can I write my own plugins?",
    a: "Yes. Plugins are written in TypeScript, and the API is fully typed. The features that ship with neosh are plugins themselves, so anything they can do, yours can too.",
    tag: "Plugins",
  },
  {
    q: "Can I turn off features I don't use?",
    a: "Yes. Every built-in feature is a plugin, and any plugin can be disabled or replaced in your config.",
    tag: "Customization",
  },
  {
    q: "What happens if I close the terminal?",
    a: "Your agents keep running. The workspace runs as its own process, and the terminal is just a window into it. Open it again later and everything is where you left it.",
    tag: "Basics",
  },
  {
    q: "Is it free?",
    a: "Yes. neosh is open source under the MIT license. You connect the AI accounts you already have.",
    tag: "Pricing",
  },
];

const tags = ["All", ...new Set(faqs.map((f) => f.tag))];
---

<section id="faq">
  <div class="wrap col">
    <div class="tags" role="tablist" aria-label="Filter questions">
      {
        tags.map((t, i) => (
          <button class:list={["tag", { active: i === 0 }]} data-tag={t}>
            {t}
          </button>
        ))
      }
    </div>
    <div class="list">
      {
        faqs.map((f, i) => (
          <div class="item" data-tag={f.tag} data-reveal style={`transition-delay:${i * 50}ms`}>
            <button class="toggle" aria-expanded="false">
              <span class="q">{f.q}</span>
              <svg class="mark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </button>
            <div class="panel">
              <div class="inner">
                <p>{f.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: 110px 0 140px;
  }

  .col {
    max-width: 820px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }

  .tag {
    font: 500 14px var(--sans);
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 18px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .tag:hover {
    color: var(--fg);
    border-color: var(--line-strong);
  }

  .tag.active {
    color: var(--fg);
    border-color: var(--accent);
    background: rgba(165, 180, 252, 0.08);
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .item {
    border-bottom: 1px solid var(--line);
  }

  .item.hidden {
    display: none;
  }

  .toggle {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 28px;
    width: 100%;
    padding: 24px 4px;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .q {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color 0.25s ease;
  }

  .toggle:hover .q,
  .item.open .q {
    color: var(--fg);
  }

  .mark {
    flex: none;
    align-self: center;
    color: var(--dim);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), color 0.25s ease;
  }

  .toggle:hover .mark {
    color: var(--accent);
  }

  .item.open .mark {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .item.open .panel {
    grid-template-rows: 1fr;
  }

  .inner {
    overflow: hidden;
  }

  .inner p {
    margin: 0;
    padding: 0 4px 26px;
    max-width: 640px;
    color: var(--muted);
    font-size: 16.5px;
    line-height: 1.7;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
  }

  .item.open .inner p {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .inner p,
    .mark {
      transition: none;
    }
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>("#faq .item");
  const tags = document.querySelectorAll<HTMLButtonElement>("#faq .tag");

  items.forEach((item) => {
    const toggle = item.querySelector<HTMLButtonElement>(".toggle")!;
    toggle.addEventListener("click", () => {
      const opening = !item.classList.contains("open");
      items.forEach((other) => {
        other.classList.remove("open");
        other.querySelector(".toggle")!.setAttribute("aria-expanded", "false");
      });
      if (opening) {
        item.classList.add("open");
        toggle.setAttribute("aria-expanded", "true");
      }
    });
  });

  tags.forEach((tag) => {
    tag.addEventListener("click", () => {
      tags.forEach((t) => t.classList.toggle("active", t === tag));
      const pick = tag.dataset.tag;
      items.forEach((item) => {
        const show = pick === "All" || item.dataset.tag === pick;
        item.classList.toggle("hidden", !show);
        if (!show && item.classList.contains("open")) {
          item.classList.remove("open");
          item.querySelector(".toggle")!.setAttribute("aria-expanded", "false");
        }
      });
    });
  });
</script>
