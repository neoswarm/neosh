<section id="how">
  <div class="wrap">
    <p class="eyebrow">How it works</p>
    <h2>The agent lives in the workspace.<br />You just visit.</h2>

    <div class="step" data-reveal>
      <div class="text">
        <h3>One workspace, every terminal</h3>
        <p>
          The workspace is a process. Terminals attach to it and mirror it, live.
          Close one, the turns keep running.
        </p>
      </div>
      <div class="visual card mirrors">
        <div class="core">workspace</div>
        <div class="wires" aria-hidden="true">
          <span class="pulse p1"></span>
          <span class="pulse p2"></span>
          <span class="pulse p3"></span>
        </div>
        <div class="minis">
          <div class="mini"><span class="mini-bar"></span><span class="typeline">❯ refactor the parser</span></div>
          <div class="mini"><span class="mini-bar"></span><span class="typeline">❯ refactor the parser</span></div>
          <div class="mini"><span class="mini-bar"></span><span class="typeline">❯ refactor the parser</span></div>
        </div>
      </div>
    </div>

    <div class="step flip" data-reveal>
      <div class="text">
        <h3>Everything is a plugin</h3>
        <p>
          The sidebar, the palette, git, approvals. All written on the public API,
          and your <code>init.ts</code> gets the same one. Replace anything.
        </p>
      </div>
      <div class="visual card code-card">
        <div class="code-title">~/.config/neosh/init.ts</div>
        <pre><code><span class="k">export async function</span> <span class="f">activate</span>({'{'} neosh {'}'}) {'{'}
  <span class="k">await</span> neosh.keymap.<span class="f">set</span>(<span class="s">"chat"</span>, <span class="s">"&lt;C-g&gt;"</span>, <span class="s">"git.status"</span>);
  <span class="k">await</span> neosh.opt.<span class="f">set</span>(<span class="s">"agent.model"</span>, <span class="s">"claude-cli/opus"</span>);
  <span class="k">await</span> neosh.rtp.<span class="f">add</span>(<span class="s">"~/src/my-plugins"</span>);
{'}'}</code></pre>
      </div>
    </div>

    <div class="step" data-reveal>
      <div class="text">
        <h3>Any model</h3>
        <p>
          423 models before you configure anything. Your <code>claude</code> login
          works as is. Switch mid turn, the agent thinks the rest with it.
        </p>
      </div>
      <div class="visual card models">
        <div class="model-window" aria-hidden="true">
          <div class="model-reel">
            <span>claude-cli/opus</span>
            <span>codex/gpt-5.2</span>
            <span>openrouter/deepseek-v3</span>
            <span>ollama/llama3.3</span>
            <span>google/gemini-2.5-pro</span>
            <span>claude-cli/opus</span>
          </div>
        </div>
        <div class="model-hint">^P picks · ⌥↑ climbs the ladder</div>
      </div>
    </div>
  </div>
</section>

